{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/version-guard.mjs",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Version guard"
          }
        ]
      }
    ]
  }
}
